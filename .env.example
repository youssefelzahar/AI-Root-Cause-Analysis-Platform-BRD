# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rca
RUN_MIGRATIONS=true

# ---------------------------------------------------------------------------
# Request context
# Phase 1 ships without authentication. These identify the seeded company/user
# that every dataset is attributed to; they must match migration 0002.
# ---------------------------------------------------------------------------
DEFAULT_COMPANY_ID=00000000-0000-0000-0000-000000000001
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000002

# ---------------------------------------------------------------------------
# Storage and uploads
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/uploads
STORAGE_TMP_DIR=/data/tmp
MAX_UPLOAD_BYTES=209715200
UPLOAD_CHUNK_BYTES=1048576
EXCEL_MAX_BYTES=26214400

# ---------------------------------------------------------------------------
# Profiling
# Set PROFILING_ASYNC=false to profile inline (used by the test suite).
# ---------------------------------------------------------------------------
PROFILING_ASYNC=true
DUCKDB_MEMORY_LIMIT=512MB
DUCKDB_THREADS=2
DUCKDB_TEMP_DIR=/data/tmp/duckdb

# ---------------------------------------------------------------------------
# Secrets
# Encrypts SQL Server passwords at rest. REQUIRED when APP_ENV is not
# development - the app refuses to start otherwise.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=dev-only-not-a-real-key_TRZ2VuZXJhdGVBUmVhbEs=
ENCRYPTION_KEYS_LEGACY=[]

# ---------------------------------------------------------------------------
# SQL Server editor limits
# ---------------------------------------------------------------------------
SQL_DEFAULT_ROW_LIMIT=1000
SQL_MAX_ROW_LIMIT=5000
SQL_DEFAULT_TIMEOUT_SECONDS=30
SQL_DATASET_MAX_ROWS=1000000

# ---------------------------------------------------------------------------
# Frontend
# API_INTERNAL_URL is read at RUNTIME by server components (container network).
# API_PROXY_TARGET is baked into the build by next.config.ts rewrites() and
# needs a rebuild to change.
# ---------------------------------------------------------------------------
API_INTERNAL_URL=http://localhost:8000
API_PROXY_TARGET=http://localhost:8000

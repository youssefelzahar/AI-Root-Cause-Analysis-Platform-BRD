# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rca
RUN_MIGRATIONS=true

# ---------------------------------------------------------------------------
# Request context
# Phase 1 ships without authentication. These identify the seeded company/user
# that every dataset is attributed to; they must match migration 0002.
# ---------------------------------------------------------------------------
DEFAULT_COMPANY_ID=00000000-0000-0000-0000-000000000001
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000002

# ---------------------------------------------------------------------------
# Storage and uploads
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/uploads
STORAGE_TMP_DIR=/data/tmp
MAX_UPLOAD_BYTES=209715200
UPLOAD_CHUNK_BYTES=1048576
EXCEL_MAX_BYTES=26214400

# ---------------------------------------------------------------------------
# Profiling
# Set PROFILING_ASYNC=false to profile inline (used by the test suite).
# ---------------------------------------------------------------------------
PROFILING_ASYNC=true
DUCKDB_MEMORY_LIMIT=512MB
DUCKDB_THREADS=2
DUCKDB_TEMP_DIR=/data/tmp/duckdb

# ---------------------------------------------------------------------------
# Root cause analysis
# Two limits on one dimension breakdown query; the engine applies the lower of
# the two. The first caps rows pulled back, the second is the top-K bound on
# values listed per dimension. Everything past it is grouped into a residual
# "(other)" bucket, so contributions still sum to 100% either way.
# ---------------------------------------------------------------------------
RCA_MAX_SEGMENTS_SCANNED=5000
RCA_MAX_VALUES_PER_DIMENSION=50

# ---------------------------------------------------------------------------
# Anomaly detection
# Safety cap on the calendar periods one KPI series may span. Statistical
# thresholds are not tunable here: they live in app/analysis/anomaly/constants.py
# where each one carries its justification.
# ---------------------------------------------------------------------------
ANOMALY_MAX_PERIODS=5000

# ---------------------------------------------------------------------------
# Investigation & evidence
# The band within which the contribution decomposition is reported as
# reconciled. Raise it only to accommodate a float-precision quirk of a specific
# storage format, never to hide drift: this is the *reporting* tolerance, and the
# correctness invariant in app/analysis/rca/constants.py is deliberately not
# tunable, because a tunable one would let a lost-rows bug be configured into a
# green tick. The tolerance actually applied is recorded on every investigation,
# so a raised value shows up in the record rather than only in the environment.
#
# INVESTIGATION_STALE_MINUTES: an investigation runs synchronously, so a row
# still marked RUNNING after this long means the process died mid-request.
# ---------------------------------------------------------------------------
INVESTIGATION_RECONCILIATION_TOLERANCE=0.000001
INVESTIGATION_STALE_MINUTES=10

# ---------------------------------------------------------------------------
# Secrets
# Encrypts SQL Server passwords at rest. REQUIRED when APP_ENV is not
# development - the app refuses to start otherwise.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=dev-only-not-a-real-key_TRZ2VuZXJhdGVBUmVhbEs=
ENCRYPTION_KEYS_LEGACY=[]

# ---------------------------------------------------------------------------
# SQL Server editor limits
# ---------------------------------------------------------------------------
SQL_DEFAULT_ROW_LIMIT=1000
SQL_MAX_ROW_LIMIT=5000
SQL_DEFAULT_TIMEOUT_SECONDS=30
SQL_DATASET_MAX_ROWS=1000000

# ---------------------------------------------------------------------------
# Frontend
# API_INTERNAL_URL is read at RUNTIME by server components (container network).
# API_PROXY_TARGET is baked into the build by next.config.ts rewrites() and
# needs a rebuild to change.
# ---------------------------------------------------------------------------
API_INTERNAL_URL=http://localhost:8000
API_PROXY_TARGET=http://localhost:8000
